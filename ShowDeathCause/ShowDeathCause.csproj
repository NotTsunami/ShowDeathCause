<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ShowDeathCause</AssemblyName>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>5.0.0</Version>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Language\**\*.json" LogicalName="Language/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Builds a Thunderstore-ready zip next to the Release output -->
  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageDir>$(OutDir)package\</PackageDir>
      <PackageZip>$(OutDir)$(AssemblyName)-$(Version).zip</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <PackageRootFiles Include="$(RepoRoot)manifest.json;$(RepoRoot)icon.png;$(RepoRoot)README.md;$(OutDir)$(AssemblyName).dll" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="@(PackageRootFiles)" DestinationFolder="$(PackageDir)" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" Overwrite="true" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

</Project>
